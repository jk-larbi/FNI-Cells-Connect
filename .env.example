# Supabase Backend Configuration (Primary Target: cjskjazsrrbfyjepwyxa, eu-west-3)
# Obtain anon public key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://cjskjazsrrbfyjepwyxa.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Firebase Backend Configuration (Google Firebase / Cloud Firestore / Cloud Functions)
# Obtain these values from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional: Firebase App Check (reCAPTCHA v3 or Enterprise)
# Obtain from Firebase Console -> App Check -> Apps -> Register Web App
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Notification Channels
VITE_EMAIL_NOTIFICATION_ENABLED=true
VITE_WHATSAPP_NOTIFICATION_ENABLED=true
