rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to get caller's profile
    function getUserProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
    
    // Helper to check if caller is administrator
    function isAdmin() {
      return isAuthenticated() && (
        getUserProfile().role in ['admin', 'super_admin', 'national_admin']
      );
    }
    
    // User Profiles
    match /profiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Ecclesiastical Regions
    match /regions/{regionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Fellowship Cells
    match /cells/{cellId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Tutors register cells during onboarding
      allow update: if isAuthenticated() && (resource.data.leader_id == request.auth.uid || resource.data.tutorUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Reporting Cycles / Periods
    match /reporting_periods/{periodId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // System Settings (Kingdom Vision, Mission, Annual Soul Target, Weekly Deadline)
    match /systemSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Cell Meeting Reports (Weekly)
    match /cellMeetingReports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.tutorUid == request.auth.uid ||
        resource.data.cellId == getUserProfile().cell_id ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.tutorUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.tutorUid == request.auth.uid && resource.data.status in ['Needs Correction', 'needs_revision', 'draft'])
      );
      allow delete: if isAdmin();
    }

    // Evangelism Reports (Weekly Outreach)
    match /evangelismReports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.tutorUid == request.auth.uid ||
        resource.data.cellId == getUserProfile().cell_id ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.tutorUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.tutorUid == request.auth.uid && resource.data.status in ['Needs Correction', 'needs_revision', 'draft'])
      );
      allow delete: if isAdmin();
    }

    // Evangelism Outreach Contacts & Follow-Up Pipeline
    match /evangelismContacts/{contactId} {
      allow read: if isAuthenticated() && (
        resource.data.tutorUid == request.auth.uid ||
        resource.data.cellId == getUserProfile().cell_id ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.tutorUid == request.auth.uid ||
        resource.data.cellId == getUserProfile().cell_id ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Report Review Logs (Audit trail for approval/corrections)
    match /reviewLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // Notifications & Dispatches
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.user_id == 'all'
      );
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // Legacy cell_reports
    match /cell_reports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.submitted_by == request.auth.uid ||
        resource.data.cell_id == getUserProfile().cell_id ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.submitted_by == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.submitted_by == request.auth.uid && resource.data.status in ['draft', 'needs_revision'])
      );
      allow delete: if isAdmin();
    }
  }
}
